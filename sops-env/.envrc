watch_dir packages/
SECRETS_FILE="secrets/${USER}.json"
watch_file "$SECRETS_FILE"
use flake .

export TMPDIR="${TMPDIR:-/tmp}"
mkdir -p "$TMPDIR"

unset SECRETS
SECRETS_FILE="secrets/${USER}.json"
watch_file "$SECRETS_FILE"

if [[ -f $SECRETS_FILE ]]; then
  echo "Loading secrets from: $SECRETS_FILE"
  if ! SECRETS=$(set -o pipefail; sops -d "$SECRETS_FILE" | jq -ce .); then
    unset SECRETS
    echo "Cannot load $SECRETS_FILE. On a trusted device, run 'create-secret --user $USER --add-key' with this device's public key, then pull the updated files." >&2
    return 1
  fi
  export SECRETS
else
  echo "-------------------------------"
  echo "No secrets file for $USER at $SECRETS_FILE"
  echo "Create one from secrets/template.json and encrypt with sops."
  echo "You can use the 'create-secret' command to do that for you!"
  echo "-------------------------------"
fi
